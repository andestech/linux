CONFIG_DEFAULT_HOSTNAME="andes-test"
CONFIG_ARCH_ANDES=y
CONFIG_ANDES_PPMA=y

CONFIG_FTMAC100=y
CONFIG_MMC_FTSDC=y
CONFIG_ATCDMAC300=y

CONFIG_SPI=y
CONFIG_SPI_ATCSPI200=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y

CONFIG_I2C=y
CONFIG_I2C_BOARDINFO=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_ATCIIC100=y
CONFIG_ATCIIC_IRQ=y

CONFIG_GPIO_ATCGPIO100=y
